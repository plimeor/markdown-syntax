Document
  Paragraph
    Text "Escaped "
    Escape "*"
    Text " text with "
    Code value="code"
    Text " and "
    Strong delimiter=*
      Text "strong "
      Emphasis delimiter=*
        Text "em"
      Text " text"
    Text "."
    SoftBreak
    Emphasis delimiter=_
      Text "under"
    Text " and "
    Strong delimiter=_
      Text "strong under"
    Text " but foo_bar stays."
    SoftBreak
    Text "Autolink "
    Autolink form=angle text="https://example.com" destination=https://example.com
    Text " and email "
    Autolink form=angle text="a@example.com" destination=mailto:a@example.com
    Text "."
    SoftBreak
    Text "Backslash hard break"
    LineBreak kind=backslash
    Text "next."
    SoftBreak
    Image destination=image.png title=none
      Text "alt "
      Emphasis delimiter=*
        Text "text"
