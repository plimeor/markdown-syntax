Document
  Definition label=Foo\] destination=/escaped title="Bracket"
  Definition label=A &amp; B destination=/entity title=none
  Paragraph
    Text "Use "
    LinkReference identifier=foo\]
      Text "escaped "
      Escape "]"
      Text " label"
    Text " and "
    LinkReference identifier=a &amp; b
      Text "entity"
    Text "."
    SoftBreak
    Link form=inline destination=/nested title=none
      Text "nested [label]"
    SoftBreak
    Image destination=/img title=none
      Text "alt "
      Escape "]"
      Text " [inner]"
