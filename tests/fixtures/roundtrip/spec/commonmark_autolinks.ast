Document
  Paragraph
    Text "Autolinks "
    Autolink form=angle text="irc://foo.bar:2233/baz" destination=irc://foo.bar:2233/baz
    Text " and "
    Autolink form=angle text="made-up-scheme://foo,bar" destination=made-up-scheme://foo,bar
    Text "."
    SoftBreak
    Text "Email "
    Autolink form=angle text="foo+special@Bar.baz-bar0.com" destination=mailto:foo+special@Bar.baz-bar0.com
    Text "."
    SoftBreak
    Text "Special "
    Autolink form=angle text="foo.!#$%&'*+/=?^_`{|}~-@example.com" destination=mailto:foo.!#$%&'*+/=?^_`{|}~-@example.com
    Text "."
    SoftBreak
    Text "Invalid email <"
    Autolink form=literal text="foo..bar@example.com" destination=mailto:foo..bar@example.com
    Text "> <"
    Autolink form=literal text="foo@example-.com" destination=mailto:foo@example-.com
    Text "> <"
    Autolink form=literal text="foo@-example.com" destination=mailto:foo@-example.com
    Text "> <foo"
    Escape "+"
    Text "@bar.example.com>."
    SoftBreak
    Text "Invalid <m:abc> <"
    Autolink form=literal text="http://foo.bar/baz" destination=http://foo.bar/baz
    Text " bim>."
