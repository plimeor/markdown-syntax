Document
  Paragraph
    Text "*"
    Link destination=/uri title=none
      Text "foo*"
  Paragraph
    Link destination=baz* title=none
      Text "foo *bar"
  Paragraph
    Text "[foo "
    HtmlInline "<bar attr=\"](baz)\">"
  Paragraph
    Text "[foo"
    Code value="](/uri)"
  Paragraph
    Text "[foo"
    Autolink form=angle text="http://example.com/?search=](uri)" destination=http://example.com/?search=](uri)
